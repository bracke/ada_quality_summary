with "../ada_quality_summary.gpr";
with "aunit";

project Ada_Quality_Summary_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("ada_quality_summary_tests.adb", "aqs_writer.adb", "aqs_trap.adb", "aqs_schema_check.adb", "aqs_demo.adb",
      "aqs_coverage.adb", "aqs_check_all.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;

   package Builder is
      for Executable ("aqs_check_all.adb") use "check_all";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Ada_Quality_Summary_Tests;
