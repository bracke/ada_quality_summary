with "aunit";
with "ada_quality";
with "project_tools";
with "terminal_styles";
with "messages";
with "jsonlib";
with "humanize";
with "hostkit";

--  Instrumented build of the production sources, the AUnit suite, and the test tools for line coverage.
project Coverage is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "../src");
   for Excluded_Source_Files use ("aqs_coverage.adb", "aqs_demo.adb", "aqs_schema_check.adb", "aqs_check_all.adb");
   for Object_Dir use "cov-obj";
   for Exec_Dir use "cov-bin";
   for Main use ("ada_quality_summary_tests.adb", "main.adb", "aqs_writer.adb", "aqs_trap.adb");
   for Create_Missing_Dirs use "True";

   Coverage_Switches := ("-fprofile-arcs", "-ftest-coverage");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-O0", "-gnat2022", "-gnata") & Coverage_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Switches ("Ada") use Coverage_Switches;
   end Linker;

   package Builder is
      for Executable ("main.adb") use "ada-quality-summary";
   end Builder;
end Coverage;
