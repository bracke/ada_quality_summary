{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/ada_quality_summary/schemas/history.schema.json",
  "title": "Project history report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "history"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/selection"
    },
    "data": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "common.schema.json#/$defs/project"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/run"
          }
        },
        "completed_count": {
          "type": "integer",
          "minimum": 0
        },
        "interrupted_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "running_count": {
          "type": "integer",
          "minimum": 0
        },
        "undated_excluded": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "project",
        "runs",
        "completed_count",
        "interrupted_count",
        "invalid_count",
        "running_count",
        "undated_excluded"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "source",
    "selection",
    "data"
  ],
  "additionalProperties": false
}
