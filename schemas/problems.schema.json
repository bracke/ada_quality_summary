{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/ada_quality_summary/schemas/problems.schema.json",
  "title": "Outstanding findings report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "problems"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/selection"
    },
    "data": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/finding"
          }
        },
        "grouped_by_indicator": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/finding_group"
          }
        },
        "totals": {
          "type": "object",
          "properties": {
            "findings": {
              "type": "integer",
              "minimum": 0
            },
            "projects": {
              "type": "integer",
              "minimum": 0
            },
            "by_severity": {
              "type": "object",
              "properties": {
                "critical": {
                  "type": "integer",
                  "minimum": 0
                },
                "high": {
                  "type": "integer",
                  "minimum": 0
                },
                "medium": {
                  "type": "integer",
                  "minimum": 0
                },
                "low": {
                  "type": "integer",
                  "minimum": 0
                },
                "info": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "critical",
                "high",
                "medium",
                "low",
                "info"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "findings",
            "projects",
            "by_severity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "findings",
        "grouped_by_indicator",
        "totals"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "source",
    "selection",
    "data"
  ],
  "additionalProperties": false
}
