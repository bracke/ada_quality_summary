{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/ada_quality_summary/schemas/trends.schema.json",
  "title": "Historical trend report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "trends"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/selection"
    },
    "data": {
      "type": "object",
      "properties": {
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "indicator_id": {
                "$ref": "common.schema.json#/$defs/indicator_id"
              },
              "name": {
                "type": "string"
              },
              "measurement_kind": {
                "type": "string",
                "enum": [
                  "integer",
                  "decimal"
                ]
              },
              "unit": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "project_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "run_id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "value": {
                      "type": "integer"
                    },
                    "observed_at": {
                      "$ref": "common.schema.json#/$defs/optional_timestamp"
                    }
                  },
                  "required": [
                    "project_id",
                    "run_id",
                    "value",
                    "observed_at"
                  ],
                  "additionalProperties": false
                }
              },
              "projects_included": {
                "type": "integer",
                "minimum": 0
              },
              "projects_excluded": {
                "type": "integer",
                "minimum": 0
              },
              "excluded_observations": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "indicator_id",
              "name",
              "measurement_kind",
              "unit",
              "points",
              "projects_included",
              "projects_excluded",
              "excluded_observations"
            ],
            "additionalProperties": false
          }
        },
        "excluded_observations": {
          "type": "integer",
          "minimum": 0
        },
        "comparison_metadata": {
          "type": "object",
          "properties": {
            "method": {
              "const": "ada_quality.history.metric_trend"
            },
            "reference": {
              "const": "current_completed_assessment"
            },
            "since": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "until": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "undated_excluded": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "method",
            "reference",
            "since",
            "until",
            "undated_excluded"
          ],
          "additionalProperties": false
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "$ref": "common.schema.json#/$defs/date"
              },
              "projects": {
                "type": "integer",
                "minimum": 0
              },
              "passing": {
                "type": "integer",
                "minimum": 0
              },
              "violations": {
                "type": "integer",
                "minimum": 0
              },
              "incomplete": {
                "type": "integer",
                "minimum": 0
              },
              "unassessed": {
                "type": "integer",
                "minimum": 0
              },
              "indicator_violations": {
                "type": "integer",
                "minimum": 0
              },
              "unknown_results": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "date",
              "projects",
              "passing",
              "violations",
              "incomplete",
              "unassessed",
              "indicator_violations",
              "unknown_results"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "series",
        "excluded_observations",
        "comparison_metadata",
        "snapshots"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "source",
    "selection",
    "data"
  ],
  "additionalProperties": false
}
