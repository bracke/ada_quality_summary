{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/ada_quality_summary/schemas/projects.schema.json",
  "title": "Project status report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "projects"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/selection"
    },
    "data": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/project"
          }
        },
        "totals": {
          "$ref": "common.schema.json#/$defs/portfolio_totals"
        }
      },
      "required": [
        "projects",
        "totals"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "source",
    "selection",
    "data"
  ],
  "additionalProperties": false
}
