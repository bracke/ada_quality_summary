{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/ada_quality_summary/schemas/indicators.schema.json",
  "title": "Indicator matrix report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "indicators"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/source"
    },
    "selection": {
      "$ref": "common.schema.json#/$defs/selection"
    },
    "data": {
      "type": "object",
      "properties": {
        "indicators": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/indicator_summary"
          },
          "maxItems": 33
        },
        "project_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "indicators",
        "project_count"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "source",
    "selection",
    "data"
  ],
  "additionalProperties": false
}
