{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/ada_quality_summary/schemas/common.schema.json",
  "title": "Ada Quality Summary shared report definitions",
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "optional_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "indicator_id": {
      "type": "string",
      "pattern": "^(STR|BLD|TST|SRC|DOC|DEP|SEC|REL|PRF)-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "optional_timestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "quality": {
      "type": "string",
      "enum": [
        "passing",
        "violations",
        "incomplete",
        "unassessed"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "structure",
        "build",
        "test",
        "source",
        "documentation",
        "dependency",
        "security",
        "release",
        "proof"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "execution": {
      "type": "string",
      "enum": [
        "not-run",
        "running",
        "succeeded",
        "blocked",
        "failed",
        "errored",
        "not-applicable"
      ]
    },
    "compliance": {
      "type": "string",
      "enum": [
        "unknown",
        "pass",
        "violation",
        "not-applicable"
      ]
    },
    "regression_kind": {
      "type": "string",
      "enum": [
        "new_violation",
        "worsened_metric",
        "increased_severity",
        "failed_gate",
        "lost_evidence",
        "policy_induced_change"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "application": {
          "const": "ada_quality"
        },
        "database_schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot": {
          "type": "string",
          "pattern": "^fnv1a64:[0-9a-f]{16}$"
        }
      },
      "required": [
        "application",
        "database_schema_version",
        "snapshot"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "include_removed": {
          "type": "boolean"
        },
        "enabled_only": {
          "type": "boolean"
        },
        "project_id": {
          "$ref": "#/$defs/optional_id"
        },
        "status": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "passing",
                "violations",
                "incomplete",
                "unassessed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "$ref": "#/$defs/optional_id"
        },
        "selected_projects": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "include_removed",
        "enabled_only",
        "project_id",
        "status",
        "limit",
        "selected_projects"
      ],
      "additionalProperties": false
    },
    "indicator_counts": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "violated": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed",
        "violated",
        "unknown",
        "not_applicable"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        },
        "quality": {
          "type": "string",
          "enum": [
            "passing",
            "violations",
            "incomplete",
            "unassessed"
          ]
        },
        "current_run_id": {
          "$ref": "#/$defs/optional_id"
        },
        "latest_run_id": {
          "$ref": "#/$defs/optional_id"
        },
        "newer_run": {
          "type": "string",
          "enum": [
            "none",
            "running",
            "interrupted",
            "invalid"
          ]
        },
        "indicators": {
          "oneOf": [
            {
              "$ref": "#/$defs/indicator_counts"
            },
            {
              "type": "null"
            }
          ]
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "project_id",
        "name",
        "path",
        "enabled",
        "removed",
        "quality",
        "current_run_id",
        "latest_run_id",
        "newer_run",
        "indicators",
        "finding_count",
        "regression_count"
      ],
      "additionalProperties": false
    },
    "portfolio_totals": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "integer",
          "minimum": 0
        },
        "passing": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed": {
          "type": "integer",
          "minimum": 0
        },
        "enabled": {
          "type": "integer",
          "minimum": 0
        },
        "disabled": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "indicator_violations": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_results": {
          "type": "integer",
          "minimum": 0
        },
        "newer_running": {
          "type": "integer",
          "minimum": 0
        },
        "newer_unfinished": {
          "type": "integer",
          "minimum": 0
        },
        "projects_with_regressions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "projects",
        "passing",
        "violations",
        "incomplete",
        "unassessed",
        "enabled",
        "disabled",
        "findings",
        "indicator_violations",
        "unknown_results",
        "newer_running",
        "newer_unfinished",
        "projects_with_regressions"
      ],
      "additionalProperties": false
    },
    "indicator_summary": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/indicator_id"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "violated": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "affected_projects": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "version",
        "passed",
        "violated",
        "unknown",
        "not_applicable",
        "missing",
        "affected_projects"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer"
            },
            "unit": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "decimal"
            },
            "basis_points": {
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "basis_points"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "enum"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "indicator_id": {
          "$ref": "#/$defs/indicator_id"
        },
        "rule": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "message": {
          "type": "string"
        },
        "relative_path": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "$ref": "#/$defs/optional_id"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "project_id",
        "run_id",
        "indicator_id",
        "rule",
        "severity",
        "message",
        "relative_path",
        "line",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "indicator_result": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/indicator_id"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "compliance": {
          "$ref": "#/$defs/compliance"
        },
        "applicable": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "measurement": {
          "$ref": "#/$defs/measurement"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "version",
        "execution",
        "compliance",
        "applicable",
        "summary",
        "evidence",
        "measurement",
        "findings"
      ],
      "additionalProperties": false
    },
    "regression": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "current_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_run_id": {
          "type": "integer",
          "minimum": 1
        },
        "indicator_id": {
          "$ref": "#/$defs/indicator_id"
        },
        "kind": {
          "$ref": "#/$defs/regression_kind"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "current_run_id",
        "baseline_run_id",
        "indicator_id",
        "kind",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "kind_counts": {
      "type": "object",
      "properties": {
        "new_violation": {
          "type": "integer",
          "minimum": 0
        },
        "worsened_metric": {
          "type": "integer",
          "minimum": 0
        },
        "increased_severity": {
          "type": "integer",
          "minimum": 0
        },
        "failed_gate": {
          "type": "integer",
          "minimum": 0
        },
        "lost_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "policy_induced_change": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "new_violation",
        "worsened_metric",
        "increased_severity",
        "failed_gate",
        "lost_evidence",
        "policy_induced_change"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "no_current_assessment",
            "no_baseline",
            "compared"
          ]
        },
        "current_run_id": {
          "$ref": "#/$defs/optional_id"
        },
        "baseline_run_id": {
          "$ref": "#/$defs/optional_id"
        },
        "excluded_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "type": "string",
                "enum": [
                  "missing_source_fingerprint",
                  "policy_changed",
                  "toolchain_changed"
                ]
              }
            },
            "required": [
              "run_id",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project_id",
        "status",
        "current_run_id",
        "baseline_run_id",
        "excluded_runs"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "invalid",
            "interrupted"
          ]
        },
        "source_fingerprint": {
          "type": "string"
        },
        "policy_fingerprint": {
          "type": "string"
        },
        "toolchain_fingerprint": {
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/optional_timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/optional_timestamp"
        },
        "quality": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "passing",
                "violations",
                "incomplete",
                "unassessed"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "state",
        "source_fingerprint",
        "policy_fingerprint",
        "toolchain_fingerprint",
        "started_at",
        "finished_at",
        "quality"
      ],
      "additionalProperties": false
    }
  }
}
